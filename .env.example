# Core API
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sawy-academy
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated browser origins allowed to call Express with credentials.
ALLOWED_ORIGINS=http://localhost:3000
# Browser-facing Express origin for large lesson uploads (bypasses the Next.js
# rewrite buffer). Local default is http://127.0.0.1:5000 when unset.
# API_PUBLIC_URL=http://127.0.0.1:5000
# Explicit trusted proxy addresses/ranges used by Express req.ip. Leave empty
# for direct deployments; never use "*" or "true" because anomaly detection
# relies on a trustworthy client IP.
TRUST_PROXY=

# Authentication cookies/sessions
# SESSION_TTL_SECONDS=2592000
# COOKIE_SECURE=true

# Private Cloudflare R2 lesson bucket (video-assets/, docs/) — API, FFmpeg
# worker, and media-gateway Worker binding only. Keep public access disabled.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Public Cloudflare R2 marketing bucket (website-assets/). Same account
# credentials as above. R2_PUBLIC_BASE_URL is the CDN / custom domain origin
# with no trailing slash (e.g. https://assets.example.com). Leave unset in
# local dev to fall back to /uploads for CMS images.
R2_PUBLIC_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Dual-bucket live checks (npm run r2:check, npm run test:r2, npm run r2:smoke-video).
# Token needs Object Read + Write on BOTH buckets. Probe objects are kept until
# you run `npm run r2:smoke-cleanup`.
# Public bucket: custom domain/CDN GET must work; write via this token only.
# Private bucket: disable r2.dev and do not attach a public custom domain.
# Protected HLS. VIDEO_MEDIA_GRANT_SECRET must be 32+ bytes and must exactly
# match the media-gateway Worker secret (`npx wrangler secret put
# VIDEO_MEDIA_GRANT_SECRET` in workers/media-gateway). VIDEO_KEY_KEK is a
# separate 32-byte base64 key or 64-character hex key; do not reuse JWT/R2/grant
# secrets.
VIDEO_MEDIA_GRANT_SECRET=
# VIDEO_MEDIA_BASE_URL is the HTTPS origin of the deployed media-gateway Worker
# (workers/media-gateway). No path, no trailing slash.
#   Production example: VIDEO_MEDIA_BASE_URL=https://media.sawyacademy.com
# Attach that hostname as a custom domain on the Worker — not on R2.
# The API rewrites HLS segments to {VIDEO_MEDIA_BASE_URL}/media?grant=...
# It is NOT R2_PUBLIC_BASE_URL, not *.r2.dev, not the private S3 endpoint,
# not the academy site origin, and not https://media.example.com (docs placeholder).
# Pair with: Worker MEDIA_ALLOWED_ORIGIN = exact academy web origin;
# VIDEO_ALLOWED_ORIGINS = the same browser origin(s); Worker VIDEO_BUCKET =
# the private lesson bucket (sawy-academy-private).
# Local: leave empty so segments are served from this API at /api/media.
VIDEO_MEDIA_BASE_URL=
VIDEO_MEDIA_GRANT_TTL_SECONDS=90
VIDEO_KEY_KEK=
VIDEO_KEY_KEK_VERSION=v1
# Exact browser origins allowed to request HLS keys/segments (comma-separated).
# Production: same origin as the live academy site (and Worker MEDIA_ALLOWED_ORIGIN).
VIDEO_ALLOWED_ORIGINS=http://localhost:3000
VIDEO_UPLOAD_MAX_BYTES=2147483648
DOCUMENT_UPLOAD_MAX_BYTES=52428800

# FFmpeg processing worker
# Leave unset to use PATH, or tools/ffmpeg/bin/{ffmpeg,ffprobe}.exe if present.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_WORKER_ID=
VIDEO_WORKER_LEASE_MS=300000
VIDEO_WORKER_HEARTBEAT_MS=60000
VIDEO_WORKER_POLL_MS=5000
VIDEO_WORKER_MAX_ATTEMPTS=5
VIDEO_WORKER_RETRY_BASE_MS=30000
VIDEO_WORKER_RETRY_MAX_MS=1800000
VIDEO_R2_UPLOAD_CONCURRENCY=8

# HLS key anomaly review. Server bounds: threshold 2-20, window 1-120
# minutes, access-log retention 1-90 days, flag retention 7-365 days.
VIDEO_ACCESS_DISTINCT_IP_THRESHOLD=3
VIDEO_ACCESS_DISTINCT_IP_WINDOW_MINUTES=10
VIDEO_ACCESS_LOG_RETENTION_DAYS=30
VIDEO_ACCESS_FLAG_RETENTION_DAYS=180

# Media-gateway Worker configuration is set in workers/media-gateway:
# MEDIA_ALLOWED_ORIGIN is a non-secret Wrangler var; set the grant secret with
# `npx wrangler secret put VIDEO_MEDIA_GRANT_SECRET`.
# MEDIA_ALLOWED_ORIGIN=https://academy.example.com
